### Input configuration
input type:touchpad {
    tap enabled
    natural_scroll enabled
    drag_lock enabled
    scroll_factor 0.4
}

input type:pointer {
    accel_profile adaptive
    pointer_accel 1.0
}

input * {
    xkb_layout "us,it,se"
    # xkb_variant "colemak,,typewriter"
    # xkb_options "grp:ctrl_space_toggle"
    repeat_delay 250
}
